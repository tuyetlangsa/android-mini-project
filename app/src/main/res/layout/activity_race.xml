<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E293B"
    android:orientation="vertical"
    android:padding="16dp"
    android:id="@+id/race">

    <!-- Header Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🏇 CUỘC ĐUA LỢN"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#F59E0B"
        android:gravity="center"
        android:padding="16dp"
        android:background="@drawable/header_bg"
        android:layout_marginBottom="16dp"/>

    <!-- Countdown Text -->
    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3"
        android:textSize="72sp"
        android:textStyle="bold"
        android:textColor="#F59E0B"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <!-- Track Area: 5 con ngựa song song -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Track 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/track_bg"
            android:padding="8dp"
            android:layout_margin="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Red"
                android:textColor="#EF4444"
                android:textStyle="bold"
                android:gravity="center"/>

            <SeekBar
                android:id="@+id/seekBar1"
                android:layout_width="460dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:max="100"
                android:thumb="@drawable/pig"
                android:progressDrawable="@drawable/seekbar_progress"
                android:rotation="270" />
        </LinearLayout>

        <!-- Track 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/track_bg"
            android:padding="8dp"
            android:layout_margin="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blue"
                android:textColor="#3B82F6"
                android:textStyle="bold"
                android:gravity="center"/>

            <SeekBar
                android:id="@+id/seekBar2"
                android:layout_width="460dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:max="100"
                android:rotation="270"
                android:thumb="@drawable/pig"
                android:progressDrawable="@drawable/seekbar_progress"/>
        </LinearLayout>

        <!-- Track 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/track_bg"
            android:padding="8dp"
            android:layout_margin="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Green"
                android:textColor="#10B981"
                android:textStyle="bold"
                android:gravity="center"/>

            <SeekBar
                android:id="@+id/seekBar3"
                android:layout_width="460dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:max="100"
                android:rotation="270"
                android:thumb="@drawable/pig"
                android:progressDrawable="@drawable/seekbar_progress"/>
        </LinearLayout>

        <!-- Track 4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/track_bg"
            android:padding="8dp"
            android:layout_margin="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gold"
                android:textColor="#F59E0B"
                android:textStyle="bold"
                android:gravity="center"/>

            <SeekBar
                android:id="@+id/seekBar4"
                android:layout_width="460dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:max="100"
                android:rotation="270"
                android:thumb="@drawable/pig"
                android:progressDrawable="@drawable/seekbar_progress"/>
        </LinearLayout>

        <!-- Track 5 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/track_bg"
            android:padding="8dp"
            android:layout_margin="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Purple"
                android:textColor="#A855F7"
                android:textStyle="bold"
                android:gravity="center"/>

            <SeekBar
                android:id="@+id/seekBar5"
                android:layout_width="460dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:max="100"
                android:rotation="270"
                android:thumb="@drawable/pig"
                android:progressDrawable="@drawable/seekbar_progress"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="▶️ BẮT ĐẦU"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_start"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="🔄 CHƠI LẠI"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_reset"
            android:visibility="gone"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnMute"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:text="🔊"
            android:textSize="20sp"
            android:background="@drawable/button_mute"/>
    </LinearLayout>

    <!-- Instructions -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Nhấn BẮT ĐẦU để bắt đầu cuộc đua!"
        android:textSize="14sp"
        android:textColor="#94A3B8"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:padding="8dp"/>
</LinearLayout>
